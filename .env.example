# Banco local: `pnpm db:dev` inicia o Postgres do Prisma e mostra a URL TCP.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
DATABASE_URL_TEST="postgres://postgres:postgres@localhost:51221/template1?sslmode=disable"

# Gere com: openssl rand -base64 33
AUTH_SECRET=""

# Credenciais OAuth do Google Cloud. Sem elas o botão do Google fica indisponível.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mails Google dos administradores iniciais, separados por vírgula.
ADMIN_EMAILS=""

# Enquanto o Google não está configurado, a tela de entrada tem dois botões: "Entrar com
# Google" entra como o rider de teste e "Entrar como administrador de teste", como o
# administrador de teste. Ignorado em produção.
ENABLE_TEST_LOGIN="false"

# Pasta das fotos dos lotes em desenvolvimento. Padrão: .data/photos
PHOTO_STORAGE_DIR=""
